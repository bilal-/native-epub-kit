{
  "version": 1,
  "maximumHeuristicRules": 16,
  "maximumExternalSchemes": 16,
  "footnoteCases": [
    {
      "name": "default-semantic-note",
      "policy": null,
      "href": "reading.xhtml#note-local",
      "semantic": true,
      "expectedPolicy": {
        "mode": "semantic",
        "heuristicRules": []
      },
      "expectedDecision": {
        "decision": "emit",
        "classification": "semantic"
      }
    },
    {
      "name": "default-ordinary-link",
      "policy": null,
      "href": "ordinary.xhtml#target",
      "semantic": false,
      "expectedPolicy": {
        "mode": "semantic",
        "heuristicRules": []
      },
      "expectedDecision": {
        "decision": "navigate"
      }
    },
    {
      "name": "navigate-mode-does-not-intercept-semantic-note",
      "policy": {
        "mode": "navigate"
      },
      "href": "reading.xhtml#note-local",
      "semantic": true,
      "expectedPolicy": {
        "mode": "navigate",
        "heuristicRules": []
      },
      "expectedDecision": {
        "decision": "navigate"
      }
    },
    {
      "name": "conservative-cross-resource-heuristic",
      "policy": {
        "mode": "semantic-and-heuristic"
      },
      "href": "notes.xhtml#note-legacy",
      "semantic": false,
      "expectedPolicy": {
        "mode": "semantic-and-heuristic",
        "heuristicRules": []
      },
      "expectedDecision": {
        "decision": "emit",
        "classification": "heuristic"
      }
    },
    {
      "name": "simple-same-resource-fragment-is-not-a-heuristic-note",
      "policy": {
        "mode": "semantic-and-heuristic"
      },
      "href": "reading.xhtml#note-legacy",
      "semantic": false,
      "expectedPolicy": {
        "mode": "semantic-and-heuristic",
        "heuristicRules": []
      },
      "expectedDecision": {
        "decision": "navigate"
      }
    },
    {
      "name": "consumer-declarative-rule",
      "policy": {
        "mode": "semantic-and-heuristic",
        "heuristicRules": [
          {
            "id": "publisher-endnotes",
            "resourceSuffix": "appendix.xhtml",
            "fragmentPrefix": "endnote-",
            "fragmentSuffix": "-body"
          }
        ]
      },
      "href": "text/appendix.xhtml?edition=1#endnote-12-body",
      "semantic": false,
      "expectedPolicy": {
        "mode": "semantic-and-heuristic",
        "heuristicRules": [
          {
            "id": "publisher-endnotes",
            "resourceSuffix": "appendix.xhtml",
            "fragmentPrefix": "endnote-",
            "fragmentSuffix": "-body"
          }
        ]
      },
      "expectedDecision": {
        "decision": "emit",
        "classification": "heuristic",
        "ruleId": "publisher-endnotes"
      }
    },
    {
      "name": "duplicate-rule-id-is-invalid",
      "policy": {
        "mode": "semantic-and-heuristic",
        "heuristicRules": [
          {
            "id": "duplicate",
            "fragmentPrefix": "fn-"
          },
          {
            "id": "duplicate",
            "resourceSuffix": "notes.xhtml"
          }
        ]
      },
      "href": "notes.xhtml#fn-1",
      "semantic": false,
      "expectedError": true
    },
    {
      "name": "raw-pattern-field-is-invalid",
      "policy": {
        "mode": "semantic-and-heuristic",
        "heuristicRules": [
          {
            "id": "unsafe",
            "pattern": ".*note.*"
          }
        ]
      },
      "href": "reading.xhtml#note",
      "semantic": false,
      "expectedError": true
    }
  ],
  "linkCases": [
    {
      "name": "default-https-is-intercepted",
      "policy": null,
      "href": "https://example.com/path",
      "expectedPolicy": {
        "allowedExternalSchemes": ["http", "https"],
        "externalLinks": "intercept",
        "unsupportedSchemes": "block"
      },
      "expectedDecision": {
        "kind": "external",
        "disposition": "intercepted",
        "scheme": "https"
      }
    },
    {
      "name": "default-mailto-is-blocked",
      "policy": null,
      "href": "mailto:reader@example.com",
      "expectedPolicy": {
        "allowedExternalSchemes": ["http", "https"],
        "externalLinks": "intercept",
        "unsupportedSchemes": "block"
      },
      "expectedDecision": {
        "kind": "unsupported",
        "disposition": "blocked",
        "scheme": "mailto"
      }
    },
    {
      "name": "consumer-allows-normalized-mailto",
      "policy": {
        "allowedExternalSchemes": ["HTTPS", " mailto "],
        "externalLinks": "intercept",
        "unsupportedSchemes": "block"
      },
      "href": "MAILTO:reader@example.com",
      "expectedPolicy": {
        "allowedExternalSchemes": ["https", "mailto"],
        "externalLinks": "intercept",
        "unsupportedSchemes": "block"
      },
      "expectedDecision": {
        "kind": "external",
        "disposition": "intercepted",
        "scheme": "mailto"
      }
    },
    {
      "name": "supported-external-can-be-blocked",
      "policy": {
        "externalLinks": "block"
      },
      "href": "https://example.com/path",
      "expectedPolicy": {
        "allowedExternalSchemes": ["http", "https"],
        "externalLinks": "block",
        "unsupportedSchemes": "block"
      },
      "expectedDecision": {
        "kind": "external",
        "disposition": "blocked",
        "scheme": "https"
      }
    },
    {
      "name": "unsupported-custom-scheme-can-be-intercepted",
      "policy": {
        "unsupportedSchemes": "intercept"
      },
      "href": "reader-action:open?id=1",
      "expectedPolicy": {
        "allowedExternalSchemes": ["http", "https"],
        "externalLinks": "intercept",
        "unsupportedSchemes": "intercept"
      },
      "expectedDecision": {
        "kind": "unsupported",
        "disposition": "intercepted",
        "scheme": "reader-action"
      }
    },
    {
      "name": "duplicate-scheme-is-invalid",
      "policy": {
        "allowedExternalSchemes": ["HTTPS", "https"]
      },
      "href": "https://example.com",
      "expectedError": true
    },
    {
      "name": "scheme-with-colon-is-invalid",
      "policy": {
        "allowedExternalSchemes": ["https:"]
      },
      "href": "https://example.com",
      "expectedError": true
    }
  ],
  "contentCases": [
    {
      "name": "element-with-content-is-returned-unchanged",
      "fragment": "note-1",
      "document": "<body><aside id=\"note-1\" epub:type=\"footnote\"><p>Note one.</p></aside><p>Later.</p></body>",
      "expectedHtml": "<aside id=\"note-1\" epub:type=\"footnote\"><p>Note one.</p></aside>"
    },
    {
      "name": "empty-anchor-before-block-returns-following-block",
      "fragment": "footnote2",
      "document": "<p>Prior note.</p>\n<br/><a id=\"footnote2\"></a><p class=\"p13\" dir=\"rtl\"><a href=\"chapter-11.xhtml#footnote-ref2\"><sup>2</sup></a><span> سہو کتابت</span></p>\n<br/><a id=\"footnote3\"></a><p>Third.</p>",
      "expectedHtml": "<p class=\"p13\" dir=\"rtl\"><a href=\"chapter-11.xhtml#footnote-ref2\"><sup>2</sup></a><span> سہو کتابت</span></p>"
    },
    {
      "name": "self-closing-anchor-before-block-returns-following-block",
      "fragment": "fn4",
      "document": "<a id=\"fn4\"/>\n<div class=\"note\"><p>Fourth.</p></div><p>Unrelated.</p>",
      "expectedHtml": "<div class=\"note\"><p>Fourth.</p></div>"
    },
    {
      "name": "empty-anchor-inside-paragraph-returns-rest-of-paragraph",
      "fragment": "fn5",
      "document": "<p><a id=\"fn5\"></a>Fifth <em>note</em>.</p><p>Unrelated.</p>",
      "expectedHtml": "Fifth <em>note</em>."
    },
    {
      "name": "empty-anchor-without-following-content-is-empty",
      "fragment": "fn6",
      "document": "<p>Body.</p><a id=\"fn6\"></a></body>",
      "expectedHtml": ""
    },
    {
      "name": "missing-fragment-is-empty",
      "fragment": "absent",
      "document": "<p id=\"present\">Present.</p>",
      "expectedHtml": ""
    },
    {
      "name": "fragment-is-matched-literally",
      "fragment": "a.b",
      "document": "<p id=\"aXb\">Wrong.</p><p id=\"a.b\">Right.</p>",
      "expectedHtml": "<p id=\"a.b\">Right.</p>"
    },
    {
      "name": "empty-anchor-in-empty-paragraph-returns-next-block",
      "fragment": "fn7",
      "document": "<p><a id=\"fn7\"></a></p>\n<p>Seventh.</p><p>Unrelated.</p>",
      "expectedHtml": "<p>Seventh.</p>"
    },
    {
      "name": "data-id-is-not-an-id",
      "fragment": "fn8",
      "document": "<p data-id=\"fn8\">Decoy.</p><p id=\"fn8\">Eighth.</p>",
      "expectedHtml": "<p id=\"fn8\">Eighth.</p>"
    },
    {
      "name": "whole-resource-footnote-uses-body-only",
      "fragment": "",
      "document": "<html><head><title>Metadata</title></head><body dir=\"rtl\"><p><a href=\"chapter.xhtml#ref1\">1</a> A separate note.</p></body></html>",
      "expectedHtml": "<p><a href=\"chapter.xhtml#ref1\">1</a> A separate note.</p>"
    },
    {
      "name": "whole-resource-empty-body-is-empty",
      "fragment": "",
      "document": "<html><head><title>Metadata</title></head><BODY></BODY></html>",
      "expectedHtml": ""
    },
    {
      "name": "whole-resource-without-body-is-not-note-content",
      "fragment": "",
      "document": "<head><title>Metadata</title></head>",
      "expectedHtml": ""
    }
  ]
}
