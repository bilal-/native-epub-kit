{
  "version": 1,
  "schemaVersion": 1,
  "sdk": { "name": "native-epub-kit", "version": "0.1.0" },
  "limits": { "maximumWarnings": 64 },
  "featureNames": [
    "local-file-source",
    "content-uri-source",
    "remote-source",
    "publication-data",
    "positions",
    "navigation",
    "restore",
    "preferences",
    "progress",
    "selection",
    "footnotes",
    "custom-fonts",
    "decorations",
    "images",
    "search",
    "diagnostics"
