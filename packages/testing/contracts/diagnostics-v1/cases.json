  "redaction": {
    "profile": "support-v1",
    "forbiddenKeys": [
      "source",
      "sourceUri",
      "publicationUri",
      "headers",
      "authorization",
      "locator",
      "title",
      "authors",
      "identifier",
      "selectedText",
      "contentHtml",
      "nativeDetails",
      "stack"
    ],
    "forbiddenFragments": [
      "file://",
      "content://",
      "http://",
      "https://",
      "/Users/",
      "Authorization",
      "Bearer "
    ]
  },
